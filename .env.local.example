# ─── Supabase ─────────────────────────────────────────────────────────
# Project Settings → API Keys. The URL is the bare project origin —
# NOT the /rest/v1/ endpoint shown next to it.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server-only, bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── Receipt scanning (optional) ──────────────────────────────────────
# Provider + API key are set per household in the app (Settings → Household),
# not here — each deployed house picks Claude or Gemini and supplies its own
# key, which is stored encrypted. This is the encryption secret for that
# column, not a provider key itself. `npm run gen:secrets`. Do not change this
# after households have configured a key — it cannot be decrypted with a
# different secret.
AI_CONFIG_ENCRYPTION_KEY=

# ─── Web push ─────────────────────────────────────────────────────────
# Generate once with `npm run gen:vapid`. Regenerating these silently
# invalidates every existing notification subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Address autocomplete (optional) ──────────────────────────────────
# Google Cloud → enable "Places API (New)" → create an API key.
# Server-side only, so restrict it by API rather than by HTTP referrer.
# Without it the address field is a plain text input.
GOOGLE_MAPS_API_KEY=

# ─── Sign-in ──────────────────────────────────────────────────────────
# Magic links need real SMTP — Supabase's built-in sender allows about two
# emails an hour, which looks broken rather than rate limited. Leave this
# unset (or "false") to show Google only.
NEXT_PUBLIC_ENABLE_MAGIC_LINK=false

# ─── Cron ─────────────────────────────────────────────────────────────
# Shared secret for the Vercel Cron endpoint. `npm run gen:secrets`.
CRON_SECRET=

# Must be the real deployed origin in production — magic links and OAuth
# redirects are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Note: kiosk and Home Assistant tokens are NOT set here. They are issued
# per household in the app (Settings → Household) and stored as hashes, so
# each token resolves to exactly the house that created it.
