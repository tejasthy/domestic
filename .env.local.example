# ─── Supabase ─────────────────────────────────────────────────────────
# Project Settings → API Keys. The URL is the bare project origin —
# NOT the /rest/v1/ endpoint shown next to it.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server-only, bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── Receipt scanning (optional) ──────────────────────────────────────
# Provider + API key are set per household in the app (Settings → Household),
# not here — each deployed house picks Claude or Gemini and supplies its own
# key, which is stored encrypted. This is the encryption secret for that
# column, not a provider key itself. `npm run gen:secrets`. Do not change this
# after households have configured a key — it cannot be decrypted with a
# different secret.
AI_CONFIG_ENCRYPTION_KEY=

# ─── Web push ─────────────────────────────────────────────────────────
# Generate once with `npm run gen:vapid`. Regenerating these silently
# invalidates every existing notification subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Address autocomplete (optional) ──────────────────────────────────
# Google Cloud → enable "Places API (New)" → create an API key.
# Server-side only, so restrict it by API rather than by HTTP referrer.
# Without it the address field is a plain text input.
GOOGLE_MAPS_API_KEY=

# ─── Sign-in ──────────────────────────────────────────────────────────
# Magic links need real SMTP — Supabase's built-in sender allows about two
# emails an hour, which looks broken rather than rate limited. Leave this
# unset (or "false") to show Google + password only.
NEXT_PUBLIC_ENABLE_MAGIC_LINK=false

# ─── CAPTCHA (optional, strongly recommended once signups are public) ──
# Cloudflare Turnstile site key. Dashboard → Turnstile → add a widget (mode:
# Managed) → Settings → Authentication → Attack Protection in Supabase, paste
# the matching secret key there. Leave unset to skip CAPTCHA entirely — fine
# for local dev, not for a publicly reachable deployment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Analytics (optional) ──────────────────────────────────────────────
# A GA4 Measurement ID (G-XXXXXXX). Leave unset and nothing loads — no
# Google script, no cookie, no request.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Cron ─────────────────────────────────────────────────────────────
# Shared secret for the Vercel Cron endpoint. `npm run gen:secrets`.
CRON_SECRET=

# ─── Platform admin (optional) ─────────────────────────────────────────
# Comma-separated emails that can see /platform-admin (cross-household
# aggregate stats + the feedback inbox). This env var only controls whether
# the page exists for that person — it is NOT the real authorization
# boundary. Every platform-admin RPC checks a matching Postgres GUC
# independently, so you must also run this once in the Supabase SQL editor
# (or any Postgres client), keeping it identical to the value below:
#
#   alter database postgres set app.platform_admin_emails = 'you@example.com';
#
# Leave both unset and the page/RPCs are inert for everyone — safe by
# default on a fresh deployment. Re-run the ALTER DATABASE statement
# whenever you change this env var.
PLATFORM_ADMIN_EMAILS=

# Must be the real deployed origin in production — magic links and OAuth
# redirects are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Note: kiosk and Home Assistant tokens are NOT set here. They are issued
# per household in the app (Settings → Household) and stored as hashes, so
# each token resolves to exactly the house that created it.
